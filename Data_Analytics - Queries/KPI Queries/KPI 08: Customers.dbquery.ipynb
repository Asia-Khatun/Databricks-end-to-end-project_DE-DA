   "source": [
    "-- KPI 08: Customers\n",
    "-- Purpose:\n",
    "-- Calculates the total number of unique customers with non-cancelled orders.\n",
    "\n",
    "SELECT\n",
    "    COUNT(DISTINCT customer_id) AS total_customers\n",
    "FROM `end-to-end_pipeline`.gold.fact_sales\n",
    "WHERE order_status <> 'Cancelled';"
   ]
  }
