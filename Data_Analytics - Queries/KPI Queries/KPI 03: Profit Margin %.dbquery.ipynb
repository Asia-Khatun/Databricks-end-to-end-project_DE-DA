   "source": [
    "-- KPI 03: Profit Margin %\n",
    "-- Purpose:\n",
    "-- Calculates total profit as a percentage of total net revenue.\n",
    "\n",
    "SELECT\n",
    "    ROUND(\n",
    "        (SUM(profit) / NULLIF(SUM(net_revenue), 0)) * 100,\n",
    "        2\n",
    "    ) AS profit_margin_pct\n",
    "FROM `end-to-end_pipeline`.gold.fact_sales;"
   ]
  }
 ],
