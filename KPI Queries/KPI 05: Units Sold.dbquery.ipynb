    "-- KPI 05: Units Sold\n",
    "-- Purpose:\n",
    "-- Calculates the total quantity sold from completed transactions.\n",
    "\n",
    "SELECT\n",
    "    SUM(quantity) AS units_sold\n",
    "FROM `end-to-end_pipeline`.gold.fact_sales\n",
    "WHERE order_status = 'Completed';"
   ]
